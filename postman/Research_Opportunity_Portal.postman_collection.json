            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Correct ID returned', function () { pm.expect(pm.response.json().id).to.eql(parseInt(pm.collectionVariables.get('id1'))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Update opportunity #1 (title, skills, positions, deadline)",
      "request": {
