            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Returns an array with at least 3 items', function () { pm.expect(pm.response.json().length).to.be.at.least(3); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Get one opportunity by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities/{{id1}}",
          "host": [
            "{{baseUrl}}"
