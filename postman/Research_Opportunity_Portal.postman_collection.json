{
  "info": {
    "name": "Research Opportunity Portal API",
    "description": "Run the requests 1 to 11 in order (or use Runner). Requests 1-3 save the new IDs into collection variables id1, id2, id3.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create opportunity #1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "opportunities"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Machine Learning for Crop Disease Detection\",\n  \"description\": \"Build image models that detect crop diseases from leaf photos.\",\n  \"research_area\": \"Machine Learning\",\n  \"faculty_name\": \"Dr. Ayesha Khan\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, TensorFlow\",\n  \"positions\": 3,\n  \"deadline\": \"2026-12-15\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Creates a row in MySQL. The new ID is saved automatically as {{id1}}."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.test('Response has an id', function () { pm.expect(json.id).to.be.a('number'); });",
              "pm.test('Status is Open', function () { pm.expect(json.status).to.eql('Open'); });",
              "pm.collectionVariables.set('id1', json.id);"
            ]
          }
        }
      ]
    },
