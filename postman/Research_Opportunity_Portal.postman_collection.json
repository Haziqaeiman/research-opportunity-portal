          "raw": "{\n  \"title\": \"Machine Learning for Crop Disease Detection (Updated)\",\n  \"required_skills\": \"Python, TensorFlow, OpenCV\",\n  \"positions\": 5,\n  \"deadline\": \"2026-12-31\"\n}",
          "options": {
